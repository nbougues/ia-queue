#!/usr/bin/env python3
"""Faux binaire Hermes pour tester la plomberie du worker sans consommer de GPU.

    stub-hermes chat -q "<prompt>" --oneshot -Q --format stream-json
    stub-hermes sessions pin <id>
    stub-hermes sessions rename <id> <titre>
"""
import json
import sys
import time
import uuid

args = sys.argv[1:]
if args[:2] == ["sessions", "pin"]:
    print("epingle : %s" % " ".join(args[2:]))
    sys.exit(0)
if args[:2] == ["sessions", "rename"]:
    print("renomme : %s -> %s" % (args[2], " ".join(args[3:])))
    sys.exit(0)
if "chat" in args and "-q" in args:
    sid = "stub-%s" % uuid.uuid4().hex[:16]
    prompt = args[args.index("-q") + 1]
    open("/tmp/stub-hermes-last-prompt.txt", "w").write(prompt)
    print(json.dumps({"type": "system", "subtype": "init", "model": "stub",
                      "session_id": "", "timestamp": int(time.time() * 1000)}))
    print("Session: %s" % sid)
    print(json.dumps({"type": "text", "text": "BILAN: test stub"}))
    print(json.dumps({"type": "result", "session_id": sid, "exit_code": 0,
                      "text": "BILAN: test stub, prompt de %s caracteres" % len(prompt),
                      "tokens": {"input": 10, "output": 5, "total": 4242},
                      "duration_ms": 120}))
    sys.exit(0)
print("stub-hermes: arguments non reconnus %s" % args, file=sys.stderr)
sys.exit(2)
